{
  "name": "arthron",
  "version": "2.0.1",
  "description": "A lightweight fetch client you assemble from plugins. Zero dependencies, returns native Response.",
  "license": "MIT",
  "author": "lapidix",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lapidix/arthron.git"
  },
  "keywords": [
    "fetch",
    "http-client",
    "interceptors",
    "middleware",
    "typescript"
  ],
  "type": "module",
  "sideEffects": false,
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@10.34.5",
  "files": [
    "dist",
    "plugins",
    "llms.txt"
  ],
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./plugins": {
      "import": {
        "types": "./dist/plugins.d.mts",
        "default": "./dist/plugins.mjs"
      },
      "require": {
        "types": "./dist/plugins.d.cts",
        "default": "./dist/plugins.cjs"
      }
    }
  },
  "scripts": {
    "build": "tsdown",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "check:types-pkg": "attw --pack .",
    "check:types-consumer": "node test/types-consumer/check.mjs",
    "check:browsers": "pnpm --dir test/browser test",
    "docs:dev": "pnpm --dir docs dev",
    "docs:build": "pnpm --dir docs build",
    "docs:preview": "pnpm --dir docs preview",
    "release:approve": "node scripts/approve-release.mjs",
    "prepublishOnly": "pnpm lint && pnpm typecheck && pnpm test && pnpm build && node scripts/smoke.mjs && pnpm check:types-pkg"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@biomejs/biome": "^2.5.15",
    "@standard-schema/spec": "^1.1.0",
    "@types/node": "^26.6.5",
    "tsdown": "^0.23.1",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  }
}
